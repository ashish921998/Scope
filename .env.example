# ─── Local Service ───
# Port for the local Express service (default: 4010)
# SCOPE_LOCAL_SERVICE_PORT=4010

# ─── Database ───
# Automatic backup before running migrations (default: true)
# SCOPE_DB_BACKUP_BEFORE_MIGRATION=true
# Directory for pre-migration backups (default: <dbDir>/backups)
# SCOPE_DB_BACKUP_DIR=

# ─── Integration Sync ───
# Auto-sync interval in seconds; 0 or unset disables (default: 0)
# SCOPE_INTEGRATIONS_AUTO_SYNC_SECONDS=0

# ─── Support Diagnostics ───
# Webhook endpoint for sending diagnostic bundles
# SCOPE_SUPPORT_DIAGNOSTICS_WEBHOOK_URL=
# Auth token included in webhook headers
# SCOPE_SUPPORT_DIAGNOSTICS_WEBHOOK_AUTH_TOKEN=
# HMAC signing secret for webhook payload verification
# SCOPE_SUPPORT_DIAGNOSTICS_WEBHOOK_SIGNING_SECRET=
# Rate-limit window in milliseconds (default: 60000)
# SCOPE_SUPPORT_SEND_RATE_LIMIT_WINDOW_MS=60000
# Max requests per rate-limit window (default: 5)
# SCOPE_SUPPORT_SEND_RATE_LIMIT_MAX=5
# Max request body size in bytes for diagnostics send (default: 32768)
# SCOPE_SUPPORT_MAX_REQUEST_BYTES=32768

# ─── Renderer ───
# API URL used by the Next.js renderer (default: http://127.0.0.1:4010)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:4010
