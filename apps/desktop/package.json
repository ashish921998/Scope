{
  "name": "@scope/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && npm run start",
    "build": "tsc -p tsconfig.json",
    "prepare:renderer": "npm --prefix ../renderer run build && node scripts/copy-renderer.mjs",
    "start": "electron dist/main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dist:mac": "npm run build && npm run prepare:renderer && electron-builder --config electron-builder.yml --mac",
    "smoke:packaged": "node scripts/smoke-packaged-app.mjs"
  },
  "dependencies": {
    "@scope/core": "0.1.0",
    "@scope/types": "0.1.0",
    "@sentry/node": "^10.42.0",
    "cors": "^2.8.5",
    "electron": "^35.0.0",
    "express": "^4.21.2",
    "keytar": "^7.9.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.5.14",
    "electron-builder": "^25.1.8"
  }
}
